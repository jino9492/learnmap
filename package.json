{
  "name": "learnmap-ai-experiment",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run build && node --env-file-if-exists=.env apps/api/src/demo-server.mjs",
    "ai": "node --env-file-if-exists=.env apps/api/src/cli.mjs",
    "demo": "node apps/api/src/cli.mjs --demo",
    "demo:web": "node --env-file-if-exists=.env apps/api/src/demo-server.mjs",
    "test": "node --env-file=scripts/test-queues.env --test tests/*.test.mjs scripts/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "prequeue:demo": "npm run build",
    "queue:demo": "node --env-file-if-exists=.env scripts/parallel-demo.mjs",
    "queue:lab": "node --env-file-if-exists=.env scripts/queue-lab.mjs",
    "benchmark:analysis": "node scripts/benchmark-analysis.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "test:e2e": "playwright test",
    "pretest": "npm run build",
    "pretest:e2e": "npm run build",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\" apps/web/graph.ts apps/web/explanation.ts",
    "start:api": "node --env-file-if-exists=.env apps/api/src/server.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:import": "node --env-file-if-exists=.env scripts/import-workspace.mjs",
    "build:web": "vite build --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.107.1",
    "fastify": "^5.12.8",
    "mariadb": "^3.5.5",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
