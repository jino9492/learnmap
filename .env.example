AI_PROVIDER=openai
# Optional per-attempt timeout. Defaults: OpenAI 60000 ms, Gemini/Ollama 180000 ms.
AI_TIMEOUT_MS=
# Concept extraction input characters per request (1000-12000).
AI_BATCH_CHARACTERS=6000
# Independent requests per analysis stage (1-32). Default: measured profile 8, other cloud 2, Ollama 1.
AI_CONCURRENCY=
# Relation requests default to 16 on the measured profile, 4 on other cloud profiles and 1 on Ollama.
# An explicit AI_CONCURRENCY also overrides this default; this setting takes priority.
AI_RELATION_CONCURRENCY=
# Web demo: reuse validated stages and share identical in-flight stages (0 or 1).
# Memory only: up to 32 stages / 16 MiB, expires after 30 minutes.
AI_ANALYSIS_CACHE=1
# Web analysis: write full lessons when requested, preserving extracted topics and evidence.
# Set eager to generate every lesson before publishing the graph (slower).
AI_DETAIL_MODE=on-demand
# Total attempts including HTTP retries, format repair and context recovery (1-8).
AI_MAX_ATTEMPTS=4

# Set learnmap-cloud only for the verified OpenAI deployment (see README).
# Empty or other models: conservative limits. Restart the server after editing.
AI_QUEUE_PROFILE=
# Optional overrides for each queue. Profile defaults (graph / interactive):
# slots 64 / 192; tokens 1280000 / 1920000; requests 3200 / 4800 per minute.
AI_GRAPH_QUEUE_CONCURRENCY=
AI_GRAPH_QUEUE_TOKENS=
AI_GRAPH_QUEUE_REQUESTS=
AI_GRAPH_QUEUE_WINDOW_MS=
AI_GRAPH_QUEUE_CAPACITY=
# Measured cloud graph profile only: 0–6000 ms, default 6000.
AI_GRAPH_QUEUE_BURST_MS=
AI_INTERACTIVE_QUEUE_CONCURRENCY=
AI_INTERACTIVE_QUEUE_TOKENS=
AI_INTERACTIVE_QUEUE_REQUESTS=
AI_INTERACTIVE_QUEUE_WINDOW_MS=
AI_INTERACTIVE_QUEUE_CAPACITY=

OPENAI_API_KEY=
# Set a model available to your account that supports Structured Outputs.
OPENAI_MODEL=
# Relations and relation reviews use OPENAI_MODEL. All other tasks use this model.
# Empty: use OPENAI_MODEL for every task.
OPENAI_FAST_MODEL=

GEMINI_API_KEY=
# Use a Gemini model supporting JSON Schema structured output.
GEMINI_MODEL=
# Relations and relation reviews use GEMINI_MODEL. All other tasks use this model.
# Empty: use GEMINI_MODEL for every task.
GEMINI_FAST_MODEL=

# Use a model already downloaded in Ollama. No API key is needed.
OLLAMA_MODEL=
# Relations and relation reviews use OLLAMA_MODEL. All other tasks use this model
# with think:false. Empty: use OLLAMA_MODEL for every task.
OLLAMA_FAST_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Active context window in tokens; larger values use more memory.
# A context-overflow HTTP 400 can expand this for one request, once, up to
# max(this value, 32768), reserving 6000 output tokens. AI_MAX_ATTEMPTS=1 disables recovery.
OLLAMA_CONTEXT_LENGTH=8192

# Public HTTPS origin when serving multiple devices behind a reverse proxy.
# Leave empty for local-only development. Never trust arbitrary forwarded headers.
APP_ORIGIN=

# MySQL API server (npm run start:api). Keep these on the backend VM.
# Example: mysql://learnmap:<url-encoded-password>@127.0.0.1:3306/learnmap
DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=8787
# Optional exact IP or CIDR of the frontend reverse proxy.
API_TRUST_PROXY=
