AI_PROVIDER=openai
# Optional per-attempt timeout. Defaults: OpenAI 60000 ms, Gemini/Ollama 180000 ms.
AI_TIMEOUT_MS=
# Concept extraction input characters per request (1000-12000).
AI_BATCH_CHARACTERS=6000
# Independent requests per analysis stage (1-4). Empty: cloud 2, Ollama 1.
AI_CONCURRENCY=
# Web demo: reuse validated stages and share identical in-flight stages (0 or 1).
# Memory only: up to 32 stages / 16 MiB, expires after 30 minutes.
AI_ANALYSIS_CACHE=1
# Total attempts including HTTP retries, format repair and context recovery (1-8).
AI_MAX_ATTEMPTS=4

OPENAI_API_KEY=
# Set a model available to your account that supports Structured Outputs.
OPENAI_MODEL=

GEMINI_API_KEY=
# Use a Gemini model supporting JSON Schema structured output.
GEMINI_MODEL=

# Use a model already downloaded in Ollama. No API key is needed.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Active context window in tokens; larger values use more memory.
# A context-overflow HTTP 400 can expand this for one request, once, up to
# max(this value, 32768), reserving 6000 output tokens. AI_MAX_ATTEMPTS=1 disables recovery.
OLLAMA_CONTEXT_LENGTH=8192
